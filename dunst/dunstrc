[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = (12, 12)   
    width = (0, 360)
    height = (0, 160)
    notification_limit = 5

    font = Iosevka Nerd Font 12
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center

    frame_width = 2
    frame_color = "#b48cff66"
    corner_radius = 12
    gap_size = 8
    padding = 14
    horizontal_padding = 14
    separator_height = 0

    icon_position = left
    min_icon_size = 32
    max_icon_size = 40
    icon_corner_radius = 8

    transparency = 0
    progress_bar_corner_radius = 6
    progress_bar_frame_width = 0

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#120c20e6"
    foreground = "#ece4ff"
    frame_color = "#3a2a5c"
    timeout = 4

[urgency_normal]
    background = "#120c20e6"
    foreground = "#ece4ff"
    frame_color = "#b48cff66"
    highlight = "#b48cff"
    timeout = 6

[urgency_critical]
    background = "#120c20e6"
    foreground = "#ffffff"
    frame_color = "#ff6b9d"
    highlight = "#ff6b9d"   
    timeout = 0
